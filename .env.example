# Banco AGT: role dedicada criada em sql/001_agente.sql (nunca a service_role)
# Pooler do Supabase em modo transação: usuário = agente_app.<project_ref>, porta 6543
AGENTE_DB_URL=postgresql://agente_app.<project_ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres

# WhatsApp via Twilio - ver docs/DEPLOY_TWILIO.md
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
# Sandbox: +14155238886 · produção: o número do WhatsApp Sender aprovado
TWILIO_WHATSAPP_FROM=+14155238886
# URL pública do webhook, exatamente como cadastrada na Twilio (entra na assinatura)
TWILIO_WEBHOOK_URL=https://<url-publica-do-agente>/webhook

# LLM
ANTHROPIC_API_KEY=
AGENTE_MODEL=claude-haiku-4-5

AGENTE_LIMITE_POR_HORA=30

# Servidor MCP (Claude) - ver docs/OAUTH_SUPABASE.md
# Produção (OAuth via Supabase Auth):
SUPABASE_URL=https://<project_ref>.supabase.co
MCP_PUBLIC_URL=https://<url-publica-do-servidor-mcp>
SUPABASE_JWT_ALG=ES256
# Teste local apenas (sem SUPABASE_URL): token fixo >= 32 caracteres e usuário de escopo
# python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_TOKEN=
MCP_WA_ID=
